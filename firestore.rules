rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: checks if request is signed in
    function signedIn() {
      return request.auth != null;
    }

    // Helper: returns current user data from /users/{uid}
    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Helper: checks if caller is document owner, or parent/child in family
    function isFamilyMember(userId) {
      return signedIn() && (
        request.auth.uid == userId
        || userId in me().get('children', [])
        || me().get('parent_id', null) == userId
      );
    }

    // Fields a client must never be able to change on itself. Role, family
    // links, age band and consent are set server-side by mono_service.
    function protectedUserFields() {
      return [
        'role', 'parent_id', 'parentId', 'children', 'uid',
        'account_type', 'device_sharing_enabled', 'age',
        'pin_hash', 'pinHash',
        'parental_consent_at', 'parental_consent_by'
      ];
    }

    // User profiles. Readable by the owner, by their parent, and by their children.
    match /users/{userId} {
      allow read: if isFamilyMember(userId);

      allow create: if signedIn() && request.auth.uid == userId;

      allow update: if signedIn()
        && request.auth.uid == userId
        && !request.resource.data.diff(resource.data)
              .affectedKeys().hasAny(protectedUserFields());

      allow delete: if false;

      // PIN hashes and lockout state. Admin SDK only — no client path in.
      match /private/{document=**} {
        allow read, write: if false;
      }
    }

    // Helper: checks access permission for task documents
    function canAccessTask() {
      return signedIn() && (
        resource.data.user_id == request.auth.uid
        || ('assigned_to_ids' in resource.data && request.auth.uid in resource.data.assigned_to_ids)
        || ('assigned_to_ids' in resource.data && resource.data.assigned_to_ids.hasAny(me().get('children', [])))
        || resource.data.user_id == me().get('parent_id', null)
      );
    }


    // ---------------------------------------------------------------
    // Task write constraints
    //
    // Verification and reward state drive real XRP payments, so they are
    // server-only: mono_service writes them with the Admin SDK, which bypasses
    // these rules. Before this restriction any assignee could set verified and
    // rewarded on their own task and self-approve a payment to themselves.
    // ---------------------------------------------------------------
    function serverOnlyTaskFields() {
      return ['verified', 'verification_method',
              'payment_submitted', 'payment_submitted_at'];
    }

    // `resource != null` guard matters: Firestore evaluates every allow
    // statement in a matched block, so the update rule is also evaluated for a
    // create, where `resource` does not yet exist. Without the guard that is an
    // evaluation error rather than a clean false.
    function isTaskCreator() {
      return signedIn()
        && resource != null
        && resource.data.get('user_id', null) == request.auth.uid;
    }

    // Only meaningful on create/update; `request.resource` is null on delete.
    function taskWriteTouchesOnly(allowed) {
      return request.resource != null
        && resource != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowed);
    }

    // Task Management
    match /tasks/{taskId} {
      allow read: if canAccessTask();

      // No client path currently creates tasks (taskService.createTask goes
      // through mono_service). Kept permissive-but-guarded rather than false so
      // that a future client-side create cannot preset reward state; safe to
      // tighten to `if false`.
      allow create: if signedIn()
        && request.resource.data.get('user_id', null) == request.auth.uid
        && !request.resource.data.keys().hasAny(serverOnlyTaskFields())
        && request.resource.data.get('rewarded', false) == false;

      // No client may update a task. Every mutation goes through mono_service
      // with the Admin SDK, which bypasses these rules:
      //   completion   -> taskService.taskCompleted
      //   verification -> taskService.taskVerified
      //   reward       -> taskService.taskRewarded
      //   edits        -> taskService.updateTask
      //
      // The temporary reward carve-out that lived here is gone: the approve
      // button now calls the backend, so nothing client-side writes a task.
      // Reward state in particular must stay server-only, since granting it
      // credits the reward ledger and initiates an XRPL payment.

      allow delete: if signedIn() && isTaskCreator();
    }

    match /test_tasks/{taskId} {
      allow read: if canAccessTask();

      // No client path currently creates tasks (taskService.createTask goes
      // through mono_service). Kept permissive-but-guarded rather than false so
      // that a future client-side create cannot preset reward state; safe to
      // tighten to `if false`.
      allow create: if signedIn()
        && request.resource.data.get('user_id', null) == request.auth.uid
        && !request.resource.data.keys().hasAny(serverOnlyTaskFields())
        && request.resource.data.get('rewarded', false) == false;

      // No client may update a task. Every mutation goes through mono_service
      // with the Admin SDK, which bypasses these rules:
      //   completion   -> taskService.taskCompleted
      //   verification -> taskService.taskVerified
      //   reward       -> taskService.taskRewarded
      //   edits        -> taskService.updateTask
      //
      // The temporary reward carve-out that lived here is gone: the approve
      // button now calls the backend, so nothing client-side writes a task.
      // Reward state in particular must stay server-only, since granting it
      // credits the reward ledger and initiates an XRPL payment.

      allow delete: if signedIn() && isTaskCreator();
    }

    // Task Comments
    match /task_comments/{commentId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.get('user_id', null) == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.get('user_id', null) == request.auth.uid;
    }

    match /test_task_comments/{commentId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.get('user_id', null) == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.get('user_id', null) == request.auth.uid;
    }

    // Task Events & History (Logged server-side or read by authorized family members)
    match /task_events/{eventId} {
      allow read: if signedIn() && (
        resource.data.user_id == request.auth.uid
        || ('assigned_to_ids' in resource.data && request.auth.uid in resource.data.assigned_to_ids)
        || ('assigned_to_ids' in resource.data && resource.data.assigned_to_ids.hasAny(me().get('children', [])))
      );
      allow write: if false;
    }

    match /test_task_events/{eventId} {
      allow read: if signedIn() && (
        resource.data.user_id == request.auth.uid
        || ('assigned_to_ids' in resource.data && request.auth.uid in resource.data.assigned_to_ids)
        || ('assigned_to_ids' in resource.data && resource.data.assigned_to_ids.hasAny(me().get('children', [])))
      );
      allow write: if false;
    }

    // User Rewards & Paid Tasks (Calculated/Updated server-side via Admin SDK)
    match /paid_tasks/{userId} {
      allow read: if isFamilyMember(userId);
      allow write: if false;
    }

    match /test_paid_tasks/{userId} {
      allow read: if isFamilyMember(userId);
      allow write: if false;
    }

    match /rewards/{rewardId} {
      allow read: if signedIn() && (
        resource.data.get('user_id', null) == request.auth.uid
        || resource.data.get('user_id', null) in me().get('children', [])
      );
      allow write: if false;
    }

    match /test_rewards/{rewardId} {
      allow read: if signedIn() && (
        resource.data.get('user_id', null) == request.auth.uid
        || resource.data.get('user_id', null) in me().get('children', [])
      );
      allow write: if false;
    }

    // Leaderboard (Public read for signed-in users, server-managed writes)
    // Append-only reward ledger — the record of truth for earnings.
    // Admin SDK only: a client able to write here could mint its own money.
    // Readable by the earner and their family so the reward views can show a
    // payout history without a backend round trip.
    match /reward_events/{eventId} {
      allow read: if signedIn() && isFamilyMember(resource.data.get('user_id', ''));
      allow write: if false;
    }

    match /test_reward_events/{eventId} {
      allow read: if signedIn() && isFamilyMember(resource.data.get('user_id', ''));
      allow write: if false;
    }

    match /leaderboard/{docId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /test_leaderboard/{docId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Notifications (Read-only for target user, created server-side via Admin SDK)
    match /notifications/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow write: if false;

      match /notifications/{notificationId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow write: if false;
      }
    }

    match /test_notifications/{notificationId} {
      allow read: if signedIn() && (
        resource == null || resource.data.get('user_id', null) == request.auth.uid
      );
      allow write: if false;
    }

    // Stories & Educational Content (Published content is read-only, drafts server-only)
    match /stories/{storyId} {
      allow read: if signedIn();
      allow write: if false;

      match /nodes/{nodeId} {
        allow read: if signedIn();
        allow write: if false;
      }
    }

    match /draft_stories/{storyId} {
      allow read, write: if false;
    }

    // Story Progress (User/family progress tracking)
    match /story_progress/{userId} {
      allow read: if isFamilyMember(userId);
      allow write: if signedIn() && request.auth.uid == userId;

      match /{allSubcollections=**} {
        allow read: if isFamilyMember(userId);
        allow write: if signedIn() && request.auth.uid == userId;
      }
    }

    // User Events / Telemetry
    match /user_events/{eventId} {
      allow read: if signedIn() && resource.data.get('user_id', null) == request.auth.uid;
      allow create: if signedIn() && request.resource.data.get('user_id', null) == request.auth.uid;
      allow update, delete: if false;
    }

    match /test_user_events/{eventId} {
      allow read: if signedIn() && resource.data.get('user_id', null) == request.auth.uid;
      allow create: if signedIn() && request.resource.data.get('user_id', null) == request.auth.uid;
      allow update, delete: if false;
    }

    // XRPL & Xumm Wallet Integration Callbacks / Services
    match /xumm_callbacks/{payloadId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /test_xumm_callbacks/{payloadId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /contracts/{contractId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /test_contracts/{contractId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /interactions/{docId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /test_interactions/{docId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /xrpl_service/{docId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /test_xrpl_service/{docId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Teen signup invites. Issued, previewed and redeemed exclusively through
    // mono_service (/api/users/child-invite*), never touched by the client.
    match /test_child_invites/{code} {
      allow read, write: if false;
    }
    match /child_invites/{code} {
      allow read, write: if false;
    }

    // Legacy client-written invites, superseded by test_child_invites. Kept
    // readable by the issuing parent so existing rows can be listed and
    // cleaned up; no client may create or alter one.
    match /pending_invites/{inviteId} {
      allow read: if signedIn() && resource.data.parent_id == request.auth.uid;
      allow write: if false;
    }

    // Server-issued child-initiated link codes.
    match /invites/{inviteId} {
      allow read, write: if false;
    }
    match /test_invites/{inviteId} {
      allow read, write: if false;
    }
  }
}

