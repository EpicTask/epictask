# Environment variables for EpicTask Docker Compose setup

# Database Configuration
POSTGRES_DB=epictask
POSTGRES_USER=epictask
POSTGRES_PASSWORD=your_secure_password_here

# Redis Configuration
REDIS_PASSWORD=your_redis_password_here

# Firebase Configuration (for services that need it)
FIREBASE_PROJECT_ID=project_id_here
FIREBASE_PRIVATE_KEY_ID=your_private_key_id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_private_key_here\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=your_service_account_email
FIREBASE_CLIENT_ID=your_client_id
FIREBASE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token

# API Keys and External Services
OPENAI_API_KEY=your_openai_api_key_here
XRPL_NETWORK=testnet
XRPL_WALLET_SEED=your_xrpl_wallet_seed

# Service URLs (for internal communication)
USER_MANAGEMENT_URL=http://user-management:8080
TASK_MANAGEMENT_URL=http://task-management:8080
PUBSUB_URL=http://pubsub:8080
XRPL_URL=http://xrpl:8080
XRPL_MANAGEMENT_URL=http://xrpl-management:3000

# External URLs (for production deployment)
EXTERNAL_USER_MANAGEMENT_URL=https://user-management-5wpxgn35iq-uc.a.run.app
EXTERNAL_TASK_MANAGEMENT_URL=https://task-management-api-us-8l3obb9a.uc.gateway.dev

# Development Configuration
NODE_ENV=development
DEBUG=true
LOG_LEVEL=debug

# Production Configuration (uncomment for production)
# NODE_ENV=production
# DEBUG=false
# LOG_LEVEL=info

# SSL Configuration (for production with HTTPS)
# SSL_CERT_PATH=/path/to/cert.pem
# SSL_KEY_PATH=/path/to/key.pem

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:19006,http://localhost:8081

# Rate Limiting
API_RATE_LIMIT=100
LOGIN_RATE_LIMIT=5

# Session Configuration
SESSION_SECRET=your_session_secret_here
JWT_SECRET=your_jwt_secret_here

# Email Configuration (if needed)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# Monitoring and Analytics
SENTRY_DSN=your_sentry_dsn_here
GOOGLE_ANALYTICS_ID=your_ga_id_here
