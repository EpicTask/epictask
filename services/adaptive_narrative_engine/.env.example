# adaptive_narrative_engine — stories, progress, payouts (FastAPI, port 8080)
#

# ── Firebase / Google Cloud ────────────────────────────────────────────────
# Path to the service account JSON (src/config/firebase_config.py).
# Leave unset on Cloud Run to use Application Default Credentials.
CREDENTIALS_PATH=/app/src/config/service_accounts/service_account.json

GCP_PROJECT_ID=

# ── HTTP ───────────────────────────────────────────────────────────────────
PORT=8080

# Comma-separated allow-list. Required when ENVIRONMENT=production.
CORS_ORIGINS=http://localhost:3000,http://localhost:19006,http://localhost:8081

DEBUG=false

# ── Environment ────────────────────────────────────────────────────────────
# ENVIRONMENT (or APP_ENV as a fallback) gates the production config check in
# src/config/settings.py. When set to "production", startup fails unless
# FIREBASE_PROJECT_ID, PUBSUB_INTERNAL_TOKEN, XRPL_SERVICE_URL and
# CORS_ORIGINS are all present.
ENVIRONMENT=development
APP_ENV=development
ENV=development

# Required in production by the check above.
FIREBASE_PROJECT_ID=
XRPL_SERVICE_URL=http://localhost:3000

# ── Service-to-service ─────────────────────────────────────────────────────
# Shared secret for the Pub/Sub push subscriber at POST /internal/pubsub/*.
# Sent by the caller as the X-Internal-Token header. When unset, that endpoint
# rejects every call with 401 rather than running unauthenticated — so generate
# a real random value, don't leave the placeholder.
PUBSUB_INTERNAL_TOKEN=change-me-generate-a-random-token

# Base URL of xrpl_management, used to request payouts.
XRPL_MANAGEMENT_URL=http://localhost:3000

# lesson_recommender. Set RECOMMENDER_ENABLED=false to skip the call entirely.
RECOMMENDER_SERVICE_URL=http://localhost:8081
# Default false: lesson-recommender is a future feature and does not currently
# build (its Cargo.toml requires a dev-dependency that does not exist on
# crates.io). With this true and the service absent, every recommendation call
# waits the full 5s timeout before falling back.
RECOMMENDER_ENABLED=false

# ── LLM ────────────────────────────────────────────────────────────────────
# "true" (the default) puts LLMService in stub mode and skips loading API keys,
# which is what you want for local work and CI.
LLM_DISABLED=true

# ── Auth ───────────────────────────────────────────────────────────────────
# "true" makes every request authenticate as a hard-coded admin. Local use
# only. It is ignored when K_SERVICE is set (i.e. on Cloud Run), and it logs a
# warning whenever it is active.
#
# Prefer FastAPI dependency overrides for tests — see src/tests/conftest.py.
# There is no magic bearer-token string; "fake_token" is not accepted.
AUTH_DISABLED_FOR_TESTING=false

