rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User profiles collection
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'parentId', 'children']);
      allow delete: if false;
    }
    
    // Pending invites collection
    match /pending_invites/{inviteId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.parent_id == request.auth.uid;
      allow update: if request.auth != null;
      allow delete: if request.auth != null;
    }

    // Invites collection
    match /invites/{inviteId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
