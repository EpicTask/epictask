{
  "name": "epictask",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "prebuild": "npx expo prebuild",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest --watchAll",
    "lint": "expo lint",
    "test:ci": "jest --runInBand",
    "preflight:ios": "npm run test:ci && npm run lint",
    "ios:pods": "cd ios && pod install",
    "ios:archive": "xcodebuild -workspace ios/epictask.xcworkspace -scheme epictask -configuration Release -destination 'generic/platform=iOS' -archivePath ios/build/epictask.xcarchive archive",
    "ios:release": "npm ci && npm run preflight:ios && npm run ios:pods && npm run ios:archive && open ios/build"
  },
  "jest": {
    "preset": "jest-expo",
    "moduleDirectories": [
      "node_modules",
      "node_modules/expo/node_modules"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg|firebase|@firebase)"
    ]
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@njtd/react-native-fieldset": "^1.0.7",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-picker/picker": "2.11.4",
    "@tanstack/react-query": "^5.84.1",
    "axios": "^1.15.0",
    "expo": "57.0.24",
    "expo-apple-authentication": "~57.0.2",
    "expo-blur": "~57.0.3",
    "expo-build-properties": "~57.0.21",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.19",
    "expo-dev-client": "~57.0.19",
    "expo-document-picker": "~57.0.2",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image-picker": "~57.0.19",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.10",
    "expo-localization": "~57.0.2",
    "expo-notifications": "~57.0.20",
    "expo-router": "~57.0.22",
    "expo-sharing": "~57.0.21",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "firebase": "^12.3.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-confirmation-code-field": "^8.0.1",
    "react-native-feather": "^1.1.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-phone-input": "^1.3.7",
    "react-native-progress": "^5.0.1",
    "react-native-reanimated": "4.5.1",
    "react-native-reanimated-carousel": "^4.0.2",
    "react-native-responsive-dimensions": "^3.1.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.1",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "react-swipeable": "^7.0.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.4",
    "@types/react-test-renderer": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "react-test-renderer": "^19.1.0",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "fast-uri": "3.1.4",
    "postcss": "8.5.18",
    "@expo/xcpretty": {
      "js-yaml": "4.3.0"
    },
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "3.15.0"
    },
    "tar": "7.5.18",
    "shell-quote": "1.9.0",
    "websocket-driver": "0.7.5",
    "undici": "6.27.0"
  },
  "private": true
}
