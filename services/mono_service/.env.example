# mono_service — tasks, users, notifications, narrative (FastAPI, port 8080)
#
# Copy to .env and fill in. Loaded via python-dotenv in src/main.py.
# Every variable below is one the code actually reads; if you add one here,
# add the os.getenv() call too, or leave it out.

# ── Firebase / Google Cloud ────────────────────────────────────────────────
# Path to the service account JSON. Read by src/config/firebase_config.py.
# Leave unset to fall back to Application Default Credentials (the right
# choice on Cloud Run, where the runtime service account is used instead).
# NOTE: the variable is CREDENTIALS_PATH, not GOOGLE_APPLICATION_CREDENTIALS.
CREDENTIALS_PATH=/app/src/config/service_accounts/service_account.json

# Used by src/config/secrets.py to resolve Secret Manager secret names.
# Defaults to task-coin-384722 when unset.
GOOGLE_CLOUD_PROJECT=task-coin-384722

# ── HTTP ───────────────────────────────────────────────────────────────────
PORT=8080

# Comma-separated allow-list. Empty means no origin is allowed, so this must
# be set for the Expo web build to reach the API.
CORS_ORIGINS=http://localhost:3000,http://localhost:19006,http://localhost:8081

# "true" returns exception detail in 500 responses. Never enable in production.
DEBUG=false

# ── Service-to-service ─────────────────────────────────────────────────────
# Base URL of xrpl_management, used when rewarding a task.
# Empty disables the payout call (src/services/tasks/task_service.py).
XRPL_SERVICE_URL=http://localhost:3000

# ── Collections ────────────────────────────────────────────────────────────
# Read by src/config/collection_names.py to pick the collection prefix.
# Known issue: both branches currently resolve to the "test_" prefix, so this
# has no effect yet.
# Unused since the collection prefix became unconditional (see
# src/config/collection_names.py). Kept only because deployed revisions may
# still set it; ENVIRONMENT below is the one that has an effect.
ENV=development

# ── Auth notes (no variables) ──────────────────────────────────────────────
# There is no AUTH_DISABLED_FOR_TESTING switch in this service, and no JWT
# signing secret: identity is a Firebase ID token verified with the Admin SDK.
# Roles come from the `role` custom claim (src/config/role_claims.py), with a
# Firestore fallback. Nothing here needs configuring for that to work.
#
# Secrets that are NOT environment variables — these live in Secret Manager
# and are fetched at runtime by src/config/secrets.py:
#   google_ai_api_key

# Shared secret for service-to-service calls from xrpl_management into
# /api/internal/* and /api/xrpl/log. Must match INTERNAL_SERVICE_TOKEN in
# xrpl_management. Auth fails closed if unset: the endpoints reject every call
# rather than accepting all of them.
INTERNAL_SERVICE_TOKEN=change-me-generate-a-random-token

# Set to "production" to enable fail-fast startup validation
# (src/config/settings.py). Outside production it is a no-op, so local and CI
# runs are unaffected. When set, FIREBASE_PROJECT_ID, INTERNAL_SERVICE_TOKEN,
# XRPL_SERVICE_URL and CORS_ORIGINS must all be present or the service refuses
# to start.
ENVIRONMENT=development

# Service account whose Google-signed OIDC token is accepted on the Pub/Sub
# push route (/api/internal/pubsub/*). Pub/Sub push cannot send custom headers,
# so that route cannot use INTERNAL_SERVICE_TOKEN.
#
# When SET:   a valid OIDC token from exactly this account is required, and the
#             shared header token is no longer accepted on that route.
# When UNSET: the route falls back to the shared header token (local dev/tests).
#
# Must match --push-auth-service-account on the subscription. See
# resources/pubsub_subscription_setup.md.
PUBSUB_PUSH_SERVICE_ACCOUNT=

# Optional. If set, the OIDC token's audience claim is verified against it.
# Pub/Sub defaults the audience to the push endpoint URL.
PUBSUB_PUSH_AUDIENCE=
