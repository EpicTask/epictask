# xrpl_management — wallets, payments, escrow (Koa/TypeScript, port 3000)
#
# Copy to .env and fill in.
#

PORT=3000
NODE_ENV=development

# ── XRPL endpoints ─────────────────────────────────────────────────────────
# src/config/clients/xrpl.ts connects to XRPL_TESTNET_WSS, falling back to
# XRPL_SOLOGENIC_WSS if the first is unset. If the WebSocket connect throws it
# retries once over JSON-RPC at JSONRPCCLIENT. With none of the three set the
# client is constructed with an empty URL and every ledger call fails.
XRPL_TESTNET_WSS=wss://s.altnet.rippletest.net:51233
XRPL_SOLOGENIC_WSS=wss://x1.sologenic.org
JSONRPCCLIENT=https://s.altnet.rippletest.net:51234

# Used only by src/tests/xrpl.test.ts, which defaults to testnet when unset.
WEBSOCKETCLIENT=wss://s.altnet.rippletest.net:51233

# ── Service-to-service ─────────────────────────────────────────────────────
# Base URL of mono_service. src/data/database.ts POSTs transaction results to
# {MONO_SERVICE_URL}/api/xrpl/log; unset produces a literal "undefined/..." URL.
MONO_SERVICE_URL=http://localhost:8080

# ── Webhooks ───────────────────────────────────────────────────────────────
# Pre-shared token for POST /xumm/webhook, compared in constant time.
# Register the webhook as https://<host>/xumm/webhook?token=<this value>.
# When unset the endpoint returns 503 and rejects every call, which is the
# safe default — but it means Xumm callbacks silently stop working, so set a
# real random value in any environment where payments run.
XUMM_WEBHOOK_TOKEN=change-me-generate-a-random-token

# ── Auth notes (no variables) ──────────────────────────────────────────────
# Callers authenticate with a Firebase ID token verified by the Admin SDK
# (src/middleware/firebase_auth.ts). Credentials come from Application Default
# Credentials — admin.initializeApp() takes no explicit config — so on Cloud
# Run the runtime service account is used, and locally you need
# GOOGLE_APPLICATION_CREDENTIALS pointing at a service account JSON.
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service_account.json
#
# Money-moving routes use requireAuthStrict, which additionally asks Firebase
# whether the session was revoked or the account disabled. No config needed.

# ── Secrets that are NOT environment variables ─────────────────────────────
# Fetched from Secret Manager at runtime by src/config/clients/xumm.ts:
#   xumm-key
#   xumm-secret

# Shared secret for calling mono_service internal endpoints (settlement
# reporting and XRPL event logging). Must match INTERNAL_SERVICE_TOKEN in
# mono_service.
INTERNAL_SERVICE_TOKEN=change-me-generate-a-random-token
